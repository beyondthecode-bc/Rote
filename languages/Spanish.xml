  <!-- Permission and onboarding -->
  <string key="permission.title">Rote necesita acceso a Accesibilidad</string>
  <string key="permission.body">Rote lee los menús de las apps y detecta qué ítems de menú elige. Nunca lee lo que escribe y nada sale de este Mac.</string>
  <string key="permission.open">Abrir Ajustes del Sistema</string>
  <string key="permission.granted">Acceso a Accesibilidad concedido</string>
