  <!-- Permission and onboarding -->
  <string key="permission.title">Rote needs Accessibility access</string>
  <string key="permission.body">Rote reads app menus and notices which menu items you pick. It never reads what you type, and nothing leaves this Mac.</string>
  <string key="permission.open">Open System Settings</string>
  <string key="permission.granted">Accessibility access granted</string>
  <string key="permission.waiting">Waiting for access… turn on Rote under Privacy &amp; Security › Accessibility</string>
  <string key="onboarding.demoItem">Reload Page</string>
  <string key="onboarding.title1">Learn the shortcuts you keep skipping</string>
  <string key="onboarding.body1">When you pick the same menu item with the mouse a few times, Rote shows you the keys. Use them, and it goes quiet.</string>
  <string key="onboarding.title3">Try it</string>
  <string key="onboarding.body3">Hold ⌘ for a moment in any app to see every shortcut it has.</string>
  <string key="onboarding.tried">You have seen the overlay. You are all set.</string>
  <string key="onboarding.menubarHint">If you don’t see the keycap icon in the menu bar, macOS may have hidden it with other menu bar items. Click the button with two left-pointing arrows (“Show Hidden Menu Bar Items”) at the left end of the icons on the right side of the menu bar to reveal it.</string>

