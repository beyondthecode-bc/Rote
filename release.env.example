# Copy to release.env and fill in. release.env is gitignored.
IDENTITY="Developer ID Application: YOUR NAME (TEAMID)"
TEAM_ID="TEAMID"
P8="/absolute/path/to/AuthKey_XXXXXXXXXX.p8"
KEY_ID="XXXXXXXXXX"
ISSUER="00000000-0000-0000-0000-000000000000"
# VirusTotal API key; release.sh aborts without one. Set it here, or keep this line as is
# and pass it in the environment: VT_API_KEY=... ./release.sh
VT_API_KEY="${VT_API_KEY:-}"
